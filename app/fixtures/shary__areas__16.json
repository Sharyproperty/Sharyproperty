نسب الزيادة على مؤشر شاري قبل ما تاخد قرارك.","ready":true},"location":{"distances":[{"value":"25","label":"دقيقة للمطار"},{"value":"35","label":"العاصمة الإدارية"},{"value":"30","label":"مدينة نصر"},{"value":"55","label":"العين السخنة"}],"paragraphs":["موقع الوحدة جوه الساحل الشمالي بيفرق في السعر: القرب من المحاور الرئيسية والخدمات بيرفع سعر المتر وبيسهّل إعادة البيع أو الإيجار بعدين.","الوحدات البعيدة عن المحاور أرخص وبمساحات أكبر لنفس الميزانية، ومناسبة للي هيسكن أكتر من اللي بيستثمر."],"points":["طريق السويس","محور محمد نجيب","المحور الأوسطي","الطريق الدائري","طريق السخنة","محور بن زايد"],"ready":true},"places":[{"key":"restaurants","title":"","text":"","items":[{"name":"مارينا مراسي","note":"مطاعم وكافيهات على المارينا","url":"","rel":""},{"name":"ممشى العلمين الجديدة","note":"ممشى سياحي على البحر","url":"https://shary.eg/ar/v2/area/Al-Alamein","rel":""},{"name":"بورتو مارينا","note":"مطاعم ومول على البحيرات","url":"","rel":""}],"more":null},{"key":"universities","title":"","text":"","items":[{"name":"جامعة العلمين الدولية","note":"مدينة العلمين الجديدة","url":"https://aiu.edu.eg","rel":""},{"name":"الأكاديمية العربية للعلوم والتكنولوجيا — فرع العلمين","note":"مدينة العلمين الجديدة","url":"","rel":""}],"more":null},{"key":"entertainment","title":"","text":"","items":[{"name":"مهرجان العلمين","note":"حفلات وفعاليات الصيف","url":"","rel":""},{"name":"أبراج العلمين الجديدة","note":"واجهة المدينة على البحر","url":"","rel":""},{"name":"شواطئ سيدي عبد الرحمن","note":"أهدى مياه في الساحل","url":"https://shary.eg/ar/v2/area/Sidi-Abdel-Rahman","rel":""},{"name":"رأس الحكمة","note":"خلجان ومياه فيروزية","url":"https://shary.eg/ar/v2/area/ras-el-hekma","rel":""}],"more":null}],"guide":[{"id":"g1","title":"مشاريع ومراحل الساحل الشمالي","text":"كل مشروع في الساحل الشمالي له طابع وسعر مختلف حسب المطور ومرحلة التسليم. قارن بين المشاريع القريبة من بعض قبل ما تختار."},{"id":"g2","title":"أنواع الوحدات ومساحاتها","text":"من استوديو وشقق صغيرة لحد فيلا مستقلة. الشقق هي الأكثر طلبًا، والتاون هاوس هو الاختيار الوسط بين الشقة والفيلا."},{"id":"g3","title":"أسعار العقارات ومتوسط سعر المتر","text":"السعر بيتحرك حسب المشروع ومرحلة التسليم والتشطيب. الأرقام اللي فوق متوسط تقريبي من الوحدات المتاحة على شاري."},{"id":"g4","title":"أنظمة السداد والتقسيط","text":"أغلب المطورين بيبدأوا من 5% لـ 20% مقدم وتقسيط من 6 لـ 10 سنين. كل ما المقدم يقل السعر الإجمالي بيزيد، فقارن التكلفة النهائية مش المقدم بس."},{"id":"g5","title":"أشهر المطورين في المنطقة","text":"وجود مطور بسمعة قوية بيقلل مخاطر التأخير وبيأثر على سعر إعادة البيع. راجع تاريخ تسليم المطور مش البراند بس."},{"id":"g6","title":"المدارس والجامعات والخدمات","text":"أكتر عامل بيفرق للمشتري اللي عنده أولاد، والقرب من الجامعات بيرفع الطلب على الإيجار طول السنة."},{"id":"g7","title":"المولات والترفيه","text":"القرب من المولات وأماكن الترفيه بيخلي الوحدة أعلى في السعر وأسرع في الإيجار."},{"id":"g8","title":"الاستثمار وعائد الإيجار","text":"العائد بيختلف حسب الموقع والتشطيب. الوحدات الصغيرة أسرع تأجيرًا، والأكبر أعلى في الزيادة السعرية."}],"faqs":[{"question":"متوسط سعر المتر في الساحل الشمالي؟","answer":"متوسط السكني حوالي 105,800 ج.م للمتر، ويختلف حسب المشروع ومرحلة التسليم."},{"question":"إيه أنسب خطة سداد متاحة دلوقتي؟","answer":"فيه عروض تبدأ من 5% مقدم وتقسيط لحد 10 سنين. تواصل معانا ونرشحلك الأنسب لميزانيتك."},{"question":"إزاي أحجز معاينة؟","answer":"املأ الفورم أو كلمنا على واتساب وهنحددلك ميعاد معاينة مع المطور."}],"lat":30.95,"lng":28.75}}}