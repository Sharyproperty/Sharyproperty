""},{"name":"البرج الأيقوني","note":"أعلى برج في أفريقيا","url":"","rel":""}],"more":{"label":"دليل العاصمة الإدارية الكامل","url":"https://shary.eg/ar/v2/blog-details/العاصمة-الإدارية-الجديدة-دليل-الكمبوندات-والخدمات-وأسعار-المتر-2026"}}],"guide":[{"id":"g1","title":"مشاريع ومراحل العاصمة الإدارية الجديدة","text":"كل مشروع في العاصمة الإدارية الجديدة له طابع وسعر مختلف حسب المطور ومرحلة التسليم. قارن بين المشاريع القريبة من بعض قبل ما تختار."},{"id":"g2","title":"أنواع الوحدات ومساحاتها","text":"من استوديو وشقق صغيرة لحد فيلا مستقلة. الشقق هي الأكثر طلبًا، والتاون هاوس هو الاختيار الوسط بين الشقة والفيلا."},{"id":"g3","title":"أسعار العقارات ومتوسط سعر المتر","text":"السعر بيتحرك حسب المشروع ومرحلة التسليم والتشطيب. الأرقام اللي فوق متوسط تقريبي من الوحدات المتاحة على شاري."},{"id":"g4","title":"أنظمة السداد والتقسيط","text":"أغلب المطورين بيبدأوا من 5% لـ 20% مقدم وتقسيط من 6 لـ 10 سنين. كل ما المقدم يقل السعر الإجمالي بيزيد، فقارن التكلفة النهائية مش المقدم بس."},{"id":"g5","title":"أشهر المطورين في المنطقة","text":"وجود مطور بسمعة قوية بيقلل مخاطر التأخير وبيأثر على سعر إعادة البيع. راجع تاريخ تسليم المطور مش البراند بس."},{"id":"g6","title":"المدارس والجامعات والخدمات","text":"أكتر عامل بيفرق للمشتري اللي عنده أولاد، والقرب من الجامعات بيرفع الطلب على الإيجار طول السنة."},{"id":"g7","title":"المولات والترفيه","text":"القرب من المولات وأماكن الترفيه بيخلي الوحدة أعلى في السعر وأسرع في الإيجار."},{"id":"g8","title":"الاستثمار وعائد الإيجار","text":"العائد بيختلف حسب الموقع والتشطيب. الوحدات الصغيرة أسرع تأجيرًا، والأكبر أعلى في الزيادة السعرية."}],"faqs":[{"question":"متوسط سعر المتر في العاصمة الإدارية الجديدة؟","answer":"متوسط السكني حوالي 63,500 ج.م للمتر، ويختلف حسب المشروع ومرحلة التسليم."},{"question":"إيه أنسب خطة سداد متاحة دلوقتي؟","answer":"فيه عروض تبدأ من 5% مقدم وتقسيط لحد 7 سنين. تواصل معانا ونرشحلك الأنسب لميزانيتك."},{"question":"إزاي أحجز معاينة؟","answer":"املأ الفورم أو كلمنا على واتساب وهنحددلك ميعاد معاينة مع المطور."}],"lat":30.02,"lng":31.7