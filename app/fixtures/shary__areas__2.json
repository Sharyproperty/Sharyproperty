unches?area%5B0%5D=2","allAreasUrl":"https://shary.eg/ar/v2/all-areas","top":{"heading":"إيه اللي بيخلّي المشروع من الأهم في المنطقة؟","paragraphs":["الترتيب مش مبني على الإعلانات، لكن على أربع حاجات بنقيسها من داتا السوق: سمعة المطور في التسليم في ميعاده، الموقع بالنسبة للمحاور والخدمات، نسبة البيع في المراحل اللي فاتت، وحركة إعادة البيع.","المشاريع دي غالبًا أعلى في المتر من غيرها في نفس المنطقة، والفرق ده مقابل مخاطرة أقل في التأخير وسيولة أعلى لو حبيت تبيع الوحدة.","لو هدفك السكن ركز على مرحلة التسليم ونسبة البناء الفعلية، ولو هدفك الاستثمار بص على تاريخ إعادة البيع في المراحل القديمة من نفس المشروع."],"points":["تاريخ تسليم المطور","القرب من المحاور","نسبة البيع السابقة","حركة إعادة البيع","نسبة البناء","خدمات المشروع"],"ranked_label":"الأعلى طلبًا دلوقتي","from_label":"يبدأ من","projects":[{"id":5,"name":"ماونتن فيو آي سيتي","developer":"ماونتن فيو","price":"7,900,000","url":"https://shary.eg/ar/v2/project/Fifth-Settlement-6/ماونتن-فيو-آي-سيتي"},{"id":1,"name":"ميفيدا","developer":"إعمار مصر","price":"8,500,000","url":"https://shary.eg/ar/v2/project/New-cairo-2/ميفيدا"},{"id":4,"name":"فيليت","developer":"سوديك","price":"10,200,000","url":"https://shary.eg/ar/v2/project/Fifth-Settlement-6/فيليت"},{"id":2,"name":"بالم هيلز القاهرة الجديدة","developer":"بالم هيلز للتعمير","price":"9,800,000","url":"https://shary.eg/ar/v2/project/New-cairo-2/بالم-هيلز-القاهرة-الجديدة"},{"id":6,"name":"كمبوند بلوم فيلدز","developer":"تطوير مصر","price":"6,400,000","url":"https://shary.eg/ar/v2/project/Mostakbal-City/بلوم-فيلدز"}]},"discover":[{"label":"شقق للبيع في القاهرة الجديدة","url":"https://shary.eg/ar/v2/for-sale/apartment/New-Cairo","sale":"sale","type":"شقة","key":"sale:19"},{"label":"تاون هاوس للبيع في القاهرة الجديدة","url":"https://shary.eg/ar/v2/for-sale/townhouse/New-Cairo","sale":"sale","type":"تاون هاوس","key":"sale:21"},{"label":"فلل للبيع في القاهرة الجديدة","url":"https://shary.eg/ar/v2/for-sale/villa/New-Cairo","sale":"sale","type":"فيلا","key":"sale:20"},{"label":"توين هاوس للبيع في القاهرة الجديدة","url":"https://shary.eg/ar/v2/for-sale/twin-house/New-Cairo","sale":"sale","type":"توين هاوس","key":"sale:22"},{"label":"دوبلكس للبيع في القاهرة الجديدة","url":"https://shary.eg/ar/v2/for-sale/duplex/New-Cairo","sale":"sale","type":"دوبلكس","key":"sale:23"},{"label":"بنتهاوس للبيع في القاهرة الجديدة","url":"https://shary.eg/ar/v2/for-sale/penthouse/New-Cairo","sale":"sale","type":"بنتهاوس","key":"sale:24"},{"label":"استوديوهات للبيع في القاهرة الجديدة","url":"https://shary.eg/ar/v2/for-sale/studio/New-Cairo","sale":"sale","type":"ستوديو","key":"sale:25"},{"label":"شقق للإيجار في القاهرة الجديدة","url":"https://shary.eg/ar/v2/for-rent/apartment/New-Cairo","sale":"rent","type":"شقة","key":"rent:19"},{"label":"مكاتب إدارية للإيجار في القاهرة الجديدة","url":"https://shary.eg/ar/v2/for-rent/office/New-Cairo","sale":"rent","type":"مكتب إداري","key":"rent:31"}],"about":{"html":"<h2>عن المنطقة</h2>\r\n\r\n<p class=\"article-note\">ملاحظة المنطقة</p>\r\n\r\n<p class=\"shary-shortcode\"></p>","text":"عن المنطقة\n\r\n\r\nملاحظة المنطقة"},"location":{"distances":[{"value":"15","label":"دقيقة للمطار"},{"value":"25","label":"العاصمة الإدارية"},{"value":"20","label":"مدينة نصر"},{"value":"45","label":"العين السخنة"}],"paragraphs":["المدينة واقعة على الحدود الشرقية للقاهرة، بين طريق السويس شمالًا والطريق الدائري غربًا، وده اللي خلاها نقطة وسط بين القاهرة القديمة والعاصمة الإدارية.","المشاريع اللي على المحاور الرئيسية بتبيع أعلى بفرق يوصل لـ 20% في المتر، لأن وقت الوصول أقصر والوحدة أسهل في إعادة البيع أو الإيجار بعدين.","الوحدات البعيدة عن المحاور أرخص وبمساحات أكبر لنفس الميزانية، ومناسبة للي هيسكن أكتر من اللي بيستثمر."],"points":["طريق السويس","محور محمد نجيب","المحور الأوسطي","الطريق الدائري","طريق السخنة","محور بن زايد"]},"places":[{"key":"restaurants","title":"","text":"","items":[{"name":"ذا ووتر واي","note":"مطاعم وكافيهات على شارع التسعين الشمالي","url":"","rel":""},{"name":"5A باي ذا ووتر واي","note":"ممشى مطاعم مفتوح في التجمع الخامس","url":"https://shary.eg/ar/v2/area/Fifth-Settlement","rel":""},{"name":"جاردن 8","note":"مول مفتوح ومطاعم وسط المساحات الخضراء","url":"","rel":""},{"name":"كايرو فستيفال سيتي","note":"منطقة مطاعم وكافيهات على الطريق الدائري","url":"","rel":""}],"more":null},{"key":"universities","title":"","text":"","items":[{"name":"الجامعة الأمريكية بالقاهرة (AUC)","note":"التجمع الخامس","url":"https://www.aucegypt.edu","rel":""},{"name":"الجامعة الألمانية بالقاهرة (GUC)","note":"التجمع الخامس","url":"https://www.guc.edu.eg","rel":"nofollow"},{"name":"جامعة المستقبل (FUE)","note":"شارع التسعين","url":"","rel":""},{"name":"الكلية الكندية الدولية (CIC)","note":"التجمع الخامس","url":"","rel":""}],"more":null},{"key":"schools","title":"","text":"","items":[{"name":"المدرسة البريطانية الدولية بالقاهرة الجديدة (NCBIS)","note":"مناهج بريطانية ودولية","url":"","rel":""},{"name":"المدرسة الإنجليزية الحديثة (MES Cairo)","note":"مناهج بريطانية وأمريكية","url":"","rel":""},{"name":"المدرسة الأمريكية الدولية (AIS)","note":"مناهج أمريكية","url":"","rel":""},{"name":"كلية مالفيرن مصر","note":"مناهج بريطانية","url":"","rel":""}],"more":null},{"key":"entertainment","title":"","text":"","items":[{"name":"كايرو فستيفال سيتي مول","note":"تسوق وسينما ومطاعم","url":"","rel":""},{"name":"كيدزانيا القاهرة","note":"مدينة ترفيهية تعليمية للأطفال","url":"","rel":""},{"name":"فاميلي بارك","note":"حدائق وألعاب للعيلة على طريق السويس","url":"","rel":""},{"name":"أوبن إير مول — مدينتي","note":"ممشى تسوق ومطاعم مفتوح","url":"https://shary.eg/ar/v2/area/Madinaty","rel":""}],"more":{"label":"أسعار العقارات في القاهرة الجديدة","url":"https://shary.eg/ar/v2/blog-details/أسعار-المتر-في-القاهرة-الجديدة-تقرير-الربع-الثالث-2026"}}],"guide":[{"id":"g1","title":"أحياء ومناطق القاهرة الجديدة","text":"المدينة مقسمة لتجمعات وأحياء، كل واحد له طابع وسعر مختلف. التجمع الخامس هو الأغلى والأكثر خدمات، ومدينة المستقبل هي الأسرع نموًا."},{"id":"g2","title":"أنواع الوحدات ومساحاتها","text":"من استوديو 55 متر لحد فيلا مستقلة فوق 400 متر. الشقق هي الأكثر طلبًا، والتاون هاوس هو الاختيار الوسط بين الشقة والفيلا."},{"id":"g3","title":"أسعار العقارات ومتوسط سعر المتر","text":"السعر بيتحرك حسب المنطقة ومرحلة التسليم والتشطيب. الأرقام اللي فوق متوسط تقريبي من الوحدات المتاحة على شاري."},{"id":"g4","title":"أنظمة السداد والتقسيط","text":"أغلب المطورين بيبدأوا من 5% لـ 20% مقدم وتقسيط من 6 لـ 10 سنين. كل ما المقدم يقل السعر الإجمالي بيزيد، فقارن التكلفة النهائية مش المقدم بس."},{"id":"g5","title":"أشهر المطورين في المنطقة","text":"وجود مطور بسمعة قوية بيقلل مخاطر التأخير وبيأثر على سعر إعادة البيع. راجع تاريخ تسليم المطور مش البراند بس."},{"id":"g6","title":"المدارس والجامعات والخدمات","text":"أكتر عامل بيفرق للمشتري اللي عنده أولاد، والقرب من الجامعات بيرفع الطلب على الإيجار طول السنة."},{"id":"g7","title":"المولات والترفيه","text":"أكبر تجمع مولات في شرق القاهرة، وده بيخلي الوحدات القريبة منها أعلى في السعر وأسرع في الإيجار."},{"id":"g8","title":"الاستثمار وعائد الإيجار","text":"العائد السنوي غالبًا بين 6% و9% حسب الموقع والتشطيب. الوحدات الصغيرة قرب الجامعات أسرع تأجيرًا، والأكبر أعلى في الزيادة السعرية."}],"faqs":[{"question":"ما الفرق بين القاهرة الجديدة والتجمع الخامس؟","answer":"التجمع الخامس جزء من القاهرة الجديدة، وهو أشهر أحيائها وأعلاها في متوسط السعر والخدمات."},{"question":"كم مساحة القاهرة الجديدة؟","answer":"المدينة من أكبر المدن الجديدة في شرق القاهرة وبتضم تجمعات وأحياء كتير بمساحات مختلفة."},{"question":"هل مدينتي تعتبر من القاهرة الجديدة؟","answer":"مدينتي قريبة جدًا وبتتحسب ضمن نطاق شرق القاهرة، وبنعرضها هنا عشان كتير من المشترين بيقارنوا بينهم."},{"question":"متوسط سعر المتر في القاهرة الجديدة؟","answer":"متوسط السكني حوالي 78,400 ج.م للمتر، ويختلف حسب الحي ومرحلة التسليم."},{"question":"إيه أنسب خطة سداد متاحة دلوقتي؟","answer":"فيه عروض تبدأ من 5% مقدم وتقسيط لحد 8 سنين. تواصل معانا ونرشحلك الأنسب لميزانيتك."},{"question":"إزاي أحجز معاينة؟","answer":"املأ الفورم أو كلمنا على واتساب وهنحددلك ميعاد معاينة مع المطور."}],"lat":30.03,"lng":31.47}}}